@model ListaVm
@{ ViewData["Title"] = Model.Titulo; }
<div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1>@Model.Titulo</h1><p>Gerencie os dados da operação e preserve o histórico.</p></div><a class="button" href="/cadastros/@Model.Tipo/novo">+ Novo cadastro</a></div>
<section class="card"><form method="get" class="toolbar"><label class="search">Pesquisar<input name="busca" value="@Model.Busca" placeholder="Nome, documento ou e-mail" /></label><button type="submit" class="secondary">Pesquisar</button><a href="/cadastros/@Model.Tipo">Limpar</a></form>
<div class="table-wrap"><table><thead><tr><th>Nome</th><th>@(Model.Tipo == "produtos" ? "Preço / estoque" : Model.Tipo == "clientes" ? "Documento / vendedor" : Model.Tipo == "vendedores" ? "E-mail" : "Identificador")</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model.Registros)
{
    var id = Ui.Id(item); var ativo = Ui.Ativo(item);
    <tr><td><strong>@Ui.Texto(item, "nome")</strong>@if(Model.Tipo == "produtos"){<small>@Ui.Texto(item, "categoria")</small>}</td><td>
    @if(Model.Tipo == "produtos") { @Ui.Moeda(Ui.Valor(item, "preco")) <small>Saldo: @Ui.Texto(item, "estoque") · Validade: @Ui.Data(item["dataValidade"])</small> }
    else if(Model.Tipo == "clientes") { @Ui.Texto(item, "documento") <small>@Ui.Texto(item, "vendedor")</small> }
    else if(Model.Tipo == "vendedores") { @Ui.Texto(item, "email") }
    else { <text>#@id</text> }
    </td><td><span class="badge @(ativo ? "green" : "red")">@(ativo ? "Ativo" : "Inativo")</span></td><td><div class="row-actions"><a class="button small secondary" href="/cadastros/@Model.Tipo/@id/editar">Editar</a>
    @if(ativo || Model.Tipo == "clientes") { <form method="post" action="/cadastros/@Model.Tipo/@id/situacao">@Html.AntiForgeryToken()<input type="hidden" name="reativar" value="@((!ativo).ToString().ToLowerInvariant())" /><button type="submit" class="small @(ativo ? "danger" : "secondary")">@(ativo ? "Desativar" : "Reativar")</button></form> }
    </div></td></tr>
}
@if(Model.Registros.Count == 0) { <tr><td colspan="4" class="empty">Nenhum cadastro encontrado.</td></tr> }
</tbody></table></div></section>
