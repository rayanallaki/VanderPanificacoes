@model PainelVm
@{ ViewData["Title"] = "Visão geral"; var pendentes = Model.Lotes.Count(l => Ui.Texto(l,"situacao")=="Recebido"); var abertas = Model.Parcelas.Where(p=>Ui.Texto(p,"situacao")!="Paga").Sum(p=>Ui.Valor(p,"valorBase")); }
<div class="page-heading"><div><span class="eyebrow">A LOJA EM UM SÓ LUGAR</span><h1>Visão geral</h1><p>Acompanhe os pedidos e organize as próximas ações.</p></div><a class="button secondary" href="/">Atualizar painel</a></div>
<div class="metrics"><a class="metric featured" href="/lotes?situacao=Recebido"><span>Lotes para conferir</span><strong>@pendentes</strong><small>Ver solicitações pendentes →</small></a><a class="metric" href="/parcelas"><span>Valores a receber</span><strong>@Ui.Moeda(abertas)</strong><small>Consultar parcelas →</small></a><a class="metric" href="/parcelas?situacao=Vencida"><span>Parcelas vencidas</span><strong>@Model.Parcelas.Count(p=>Ui.Texto(p,"situacao")=="Vencida")</strong><small>Ver pendências →</small></a><a class="metric" href="/cadastros/produtos"><span>Produtos ativos</span><strong>@Model.Produtos.Count(Ui.Ativo)</strong><small>Gerenciar catálogo →</small></a></div>
<section class="card"><div class="section-heading"><div><h2>Últimos lotes recebidos</h2><p>Abra um lote para consultar ou conferir os pedidos.</p></div><a href="/lotes">Ver todos os lotes →</a></div><div class="table-wrap"><table><thead><tr><th>Lote</th><th>Vendedor</th><th>Recebimento</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach(var lote in Model.Lotes.Take(6)){<tr><td>#@Ui.Id(lote)</td><td>@Ui.Texto(lote,"vendedor")</td><td>@Ui.Data(lote["dataRecebimento"])</td><td><span class="badge @(Ui.Texto(lote,"situacao")=="Recebido"?"gold":"neutral")">@Ui.Texto(lote,"situacao")</span></td><td><a class="button secondary small" href="/lotes/@Ui.Id(lote)">Abrir lote</a></td></tr>}
@if(Model.Lotes.Count==0){<tr><td colspan="5" class="empty">Os lotes enviados pelo aplicativo aparecerão aqui.</td></tr>}
</tbody></table></div></section>
