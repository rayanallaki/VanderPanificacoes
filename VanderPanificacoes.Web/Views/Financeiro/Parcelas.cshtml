@model List<JsonObject>
@{ ViewData["Title"] = "Parcelas"; var situacao=ViewData["Situacao"]?.ToString(); }
<div class="page-heading"><div><span class="eyebrow">CONTAS A RECEBER</span><h1>Parcelas</h1><p>Confirmar uma venda gera parcelas. O recebimento deve ser registrado separadamente.</p></div></div>
<section class="card"><form method="get" class="toolbar"><label>Situação<select name="situacao"><option value="">Todas</option>@foreach(var s in new[]{"Aberta","Vencida","Paga"}){<option selected="@(s==situacao)">@s</option>}</select></label><button type="submit" class="secondary">Filtrar</button></form><div class="table-wrap"><table><thead><tr><th>Cliente / venda</th><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Situação</th><th>Recebimento</th><th>Ação</th></tr></thead><tbody>
@foreach(var p in Model){var situ=Ui.Texto(p,"situacao");<tr><td><strong>@Ui.Texto(p,"cliente")</strong><small>Venda #@Ui.Id(p,"vendaId")</small></td><td>@Ui.Texto(p,"numero")</td><td>@Ui.Data(p["vencimento"])</td><td>@Ui.Moeda(Ui.Valor(p,"valorBase"))</td><td><span class="badge @(situ=="Paga"?"green":situ=="Vencida"?"red":"gold")">@situ</span></td><td>@if(situ=="Paga"){@Ui.Data(p["dataRecebimento"])<small>@Ui.Moeda(Ui.Valor(p,"valorRecebido")) · @Ui.Texto(p,"formaPagamentoRecebida")</small>}else{<text>Aguardando pagamento</text>}</td><td>@if(situ!="Paga"){<a class="button small" href="/parcelas/@Ui.Id(p)/receber">Receber parcela</a>}else{<span>Quitada</span>}</td></tr>}
@if(Model.Count==0){<tr><td colspan="7" class="empty">Nenhuma parcela encontrada.</td></tr>}
</tbody></table></div></section>
