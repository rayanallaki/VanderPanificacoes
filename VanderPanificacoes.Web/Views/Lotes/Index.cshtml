@model List<JsonObject>
@{ ViewData["Title"] = "Lotes"; var situacao = ViewData["Situacao"]?.ToString(); }
<div class="page-heading"><div><span class="eyebrow">PEDIDOS DO VENDEDOR</span><h1>Lotes recebidos</h1><p>Confira as solicitações antes de gerar as vendas.</p></div></div>
<section class="card"><form method="get" class="toolbar"><label>Situação<select name="situacao"><option value="">Todas</option>@foreach(var s in new[]{"Recebido","Confirmado","Cancelado"}){<option selected="@(s == situacao)">@s</option>}</select></label><button type="submit" class="secondary">Filtrar</button></form><div class="table-wrap"><table><thead><tr><th>Lote</th><th>Vendedor</th><th>Recebido em</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach(var lote in Model) { var id = Ui.Id(lote); var recebido = Ui.Texto(lote, "situacao") == "Recebido"; <tr><td>#@id</td><td>@Ui.Texto(lote,"vendedor")</td><td>@Ui.Data(lote["dataRecebimento"])</td><td><span class="badge @(recebido ? "gold" : "neutral")">@Ui.Texto(lote,"situacao")</span></td><td><div class="row-actions"><a class="button small secondary" href="/lotes/@id">@(recebido ? "Conferir lote" : "Ver detalhes")</a>@if(recebido){<a class="button small danger" href="/lotes/@id/cancelar">Cancelar</a>}</div></td></tr> }
@if(Model.Count==0){<tr><td colspan="5" class="empty">Nenhum lote encontrado.</td></tr>}
</tbody></table></div></section>
